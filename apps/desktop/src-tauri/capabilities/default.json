{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Least-privilege permissions: copy receipt images, open WhatsApp Desktop links, and install signed updates after confirmation.",
  "windows": ["main"],
  "permissions": [
    "updater:default",
    "process:allow-restart",
    {
      "identifier": "fs:allow-write-file",
      "allow": [{ "path": "$DOWNLOAD/*" }]
    },
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "whatsapp://*" }]
    }
  ]
}
