{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Escuela Futbol",
  "version": "0.1.0",
  "identifier": "com.escuelafutbol.desktop",
  "build": {
    "beforeDevCommand": "pnpm --dir ../web dev",
    "beforeBuildCommand": "pnpm --dir ../web build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Escuela Futbol",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA5MDcwMDJDM0QyM0U4M0UKUldRKzZDTTlMQUFIQ1ZGWGlCcURFRzRoL0pqakFYYVgzT2pJWm5mMkw1TkFRTXdKM0ZCdWUxbk8K",
      "endpoints": [
        "https://github.com/CT-Zodiako/escuela-futbol/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Business",
    "shortDescription": "Gestión de pagos para una escuela de fútbol",
    "longDescription": "Aplicación de escritorio para gestionar estudiantes, pagos y reportes.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "displayLanguageSelector": false,
        "languages": ["Spanish"],
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
