generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id           String   @id @default(uuid())
  email        String   @unique @map("correo")
  passwordHash String   @map("contrasena_hash")
  createdAt    DateTime @default(now()) @map("creado_en")

  @@map("administradores")
}

model Student {
  id              String    @id @default(uuid())
  name            String    @map("nombre")
  document        String?   @map("documento")
  phone           String?   @map("telefono")
  isActive        Boolean   @default(true) @map("activo")
  activationMonth String    @map("mes_activacion")
  clientMutationId String?  @unique @db.Uuid @map("mutacion_cliente_id")
  createdAt       DateTime  @default(now()) @map("creado_en")
  payments        Payment[]

  @@map("estudiantes")
}

model Payment {
  id          String   @id @default(uuid())
  studentId   String   @map("estudiante_id")
  student     Student  @relation(fields: [studentId], references: [id])
  paymentDate DateTime @map("fecha_pago")
  receiptNumber Int?   @unique @map("numero_comprobante")
  clientMutationId String? @unique @map("mutacion_cliente_id")
  amount      Int      @map("monto")
  method      String   @default("cash") @map("metodo")
  concept     String?  @map("concepto")
  note        String?  @map("observacion")
  createdAt   DateTime @default(now()) @map("creado_en")

  @@map("pagos")
}

// A single row is locked for the duration of each payment creation transaction.
model ReceiptCounter {
  id Int @id
  value Int

  @@map("receipt_counter")
}
