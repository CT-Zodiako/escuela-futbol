{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "product": "Escuela Futbol",
    "phase": "4",
    "status": "draft",
    "colorMode": "light",
    "motion": "none"
  },
  "primitive": {
    "color": {
      "white": "#FFFFFF",
      "slate-50": "#F8FAFC",
      "slate-100": "#F1F5F9",
      "slate-200": "#E2E8F0",
      "slate-500": "#64748B",
      "slate-700": "#334155",
      "slate-900": "#0F172A",
      "blue-700": "#1D4ED8",
      "blue-100": "#DBEAFE",
      "green-700": "#15803D",
      "green-100": "#DCFCE7",
      "amber-700": "#B45309",
      "amber-100": "#FEF3C7",
      "red-700": "#B91C1C",
      "red-100": "#FEE2E2"
    },
    "spacing": {
      "xs": "4px",
      "sm": "8px",
      "md": "12px",
      "lg": "16px",
      "xl": "24px",
      "2xl": "32px",
      "3xl": "48px"
    },
    "radius": {
      "sm": "4px",
      "md": "6px",
      "lg": "8px"
    },
    "typography": {
      "fontFamily": "system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
      "bodySize": "16px",
      "bodyLineHeight": "1.5",
      "smallSize": "14px",
      "headingLineHeight": "1.25"
    },
    "motion": {
      "duration": "0ms"
    }
  },
  "semantic": {
    "color": {
      "surface": {
        "page": "{primitive.color.slate-50}",
        "card": "{primitive.color.white}",
        "subtle": "{primitive.color.slate-100}"
      },
      "content": {
        "primary": "{primitive.color.slate-900}",
        "secondary": "{primitive.color.slate-700}",
        "muted": "{primitive.color.slate-500}",
        "onAccent": "{primitive.color.white}"
      },
      "border": {
        "default": "{primitive.color.slate-200}",
        "strong": "{primitive.color.slate-500}"
      },
      "action": {
        "primary": "{primitive.color.blue-700}",
        "focus": "{primitive.color.blue-700}"
      },
      "status": {
        "paid": "{primitive.color.green-700}",
        "paidSurface": "{primitive.color.green-100}",
        "pending": "{primitive.color.amber-700}",
        "pendingSurface": "{primitive.color.amber-100}",
        "error": "{primitive.color.red-700}",
        "errorSurface": "{primitive.color.red-100}",
        "info": "{primitive.color.blue-700}",
        "infoSurface": "{primitive.color.blue-100}"
      }
    },
    "layout": {
      "pagePadding": "{primitive.spacing.xl}",
      "sectionGap": "{primitive.spacing.xl}",
      "controlGap": "{primitive.spacing.md}"
    },
    "typography": {
      "body": {
        "fontFamily": "{primitive.typography.fontFamily}",
        "fontSize": "{primitive.typography.bodySize}",
        "lineHeight": "{primitive.typography.bodyLineHeight}"
      },
      "label": {
        "fontSize": "{primitive.typography.smallSize}",
        "lineHeight": "{primitive.typography.bodyLineHeight}"
      },
      "heading": {
        "lineHeight": "{primitive.typography.headingLineHeight}"
      }
    }
  },
  "component": {
    "control": {
      "minHeight": "44px",
      "radius": "{primitive.radius.md}",
      "horizontalPadding": "{primitive.spacing.lg}"
    },
    "card": {
      "radius": "{primitive.radius.lg}",
      "padding": "{primitive.spacing.xl}"
    },
    "modal": {
      "radius": "{primitive.radius.lg}",
      "padding": "{primitive.spacing.xl}"
    },
    "alert": {
      "radius": "{primitive.radius.md}",
      "duration": "0ms",
      "dismissible": true
    }
  }
}
